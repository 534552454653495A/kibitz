{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kibitz review agent output",
  "description": "Rendered into the job summary and uploaded as review.json. verdict=request_changes makes the check red; there is no other channel (no comments, by design).",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["approve", "request_changes"]
    },
    "summary": {
      "type": "string",
      "description": "Two to five sentences: what the diff does and whether the evidence supports it."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "issue", "suggestion"],
        "properties": {
          "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "issue": { "type": "string" },
          "suggestion": { "type": "string" }
        }
      }
    }
  }
}
